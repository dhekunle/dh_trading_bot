# Set these in Render (Environment tab). Never commit real values to GitHub.

# --- Admin and security (required) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=

# --- Members ---
# 1 = you approve each new account in Admin > Members. 0 = new accounts get access straight away.
REQUIRE_APPROVAL=1
# Hosted Postgres so accounts survive redeploys, e.g. postgresql://user:pass@host/dbname
DATABASE_URL=

# --- Patience Bot ---
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MY_PERSONAL_CHAT_ID=

# --- 3 min Bot (optional: falls back to the Patience values if left empty) ---
GROQ_API_KEY_3MIN=
TELEGRAM_BOT_TOKEN_3MIN=
TELEGRAM_CHAT_ID_3MIN=
MY_PERSONAL_CHAT_ID_3MIN=
